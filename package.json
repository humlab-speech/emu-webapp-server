{
  "name": "emuwebapp-server",
  "version": "1.0.0",
  "description": "A server pretending to be an instance of Gitlab for interoperability with Emu-WebApp",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "nodemon --exitcrash src/main.js",
    "start": "node src/main.js",
    "dev-restart": "docker-compose stop emu-webapp-server && docker-compose up -d emu-webapp-server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humlab-speech/emu-webapp-server.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/humlab-speech/emu-webapp-server/issues"
  },
  "homepage": "https://github.com/humlab-speech/emu-webapp-server#readme",
  "dependencies": {
    "colors": "^1.4.0",
    "cookie": "^0.7.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "mongodb": "^6.21.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
